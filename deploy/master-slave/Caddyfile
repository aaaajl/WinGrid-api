# 生产入口 Caddyfile（一主多从）
#
# 部署前请把 SLAVE1_IP 换成从节点内网 IP（与主节点同 VPC、对 Caddy 机开放 3888）。
# 校验并热加载：
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# 策略：
#   api.wingrid.tech     → 仅本机主节点（不分流）
#   ai.wormholexyz.xyz   → 控制面钉主；数据面主+从加权负载（主 1 : 从 9）

api.wingrid.tech {
	tls /etc/caddy/api-wingrid-cert.pem /etc/caddy/api-wingrid-key.pem
	reverse_proxy http://127.0.0.1:3888
}

mp.wormholexyz.xyz {
	# 启用 HTTPS（自动从 Let's Encrypt 获取证书）
	#tls carmine.joint@gmail.com # 替换为你的邮箱地址

	# 启用 Gzip 压缩
	encode gzip

	# 处理 /h5/* 路径（优先匹配）
	handle /h5/* {
		root * /var/www/static/
		file_server
	}

	# 反向代理配置
	handle_path /longevity/* {
		reverse_proxy http://127.0.0.1:8888 {
			# 可选：设置请求头
		}
	}

	# 👉 新增 market 服务
	handle_path /market/* {
		reverse_proxy http://127.0.0.1:8090 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# 可选：处理根路径的请求
	handle / {
		respond "Welcome to mp.wormholexyz.xyz" 200
	}

	# 安全相关配置
	header {
		# 防止 MIME 类型嗅探
		X-Content-Type-Options nosniff
		# 防止点击劫持
		X-Frame-Options DENY
		# 推荐的安全策略
		Referrer-Policy strict-origin-when-cross-origin
		# 缓存控制（可根据需求调整）
		Cache-Control "public, max-age=3600"
	}

	# 可选：日志配置（JSON 格式）
	log {
		output file /var/log/caddy/access.log
		format json
	}
}


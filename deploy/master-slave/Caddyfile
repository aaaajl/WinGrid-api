www.wormholexyz.xyz {
	# tls carmine.joint@gmail.com

	# 启用 Gzip 压缩
	encode gzip
	# ---------- 微信验证文件（优先匹配） ----------
	handle /MP_verify_D8XHQZsmeUG1KefI.txt {
		root * /var/www/static/
		file_server
	}

	# 将所有请求代理到 4001 端口
	reverse_proxy http://127.0.0.1:4001

	# 安全相关配置
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Cache-Control "public, max-age=3600"
	}

	# 日志配置（JSON 格式）
	log {
		output file /var/log/caddy/access.log
		format json
	}
}

ai.wormholexyz.xyz {
	#tls carmine.joint@gmail.com

	encode gzip zstd

	# —— 控制面：只打本机主节点 ——
	handle /api/* {
		reverse_proxy http://127.0.0.1:3888 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /dashboard/* {
		reverse_proxy http://127.0.0.1:3888
	}

	handle /pg/* {
		reverse_proxy http://127.0.0.1:3888 {
			flush_interval -1
		}
	}

	# —— 数据面：主 + 从（权重 1:3，从节点吃更多转发流量）——
	# TODO: 将 SLAVE1_IP 替换为从节点内网 IP，例如 172.16.0.x
	handle /v1/* {
		reverse_proxy http://127.0.0.1:3888 http://127.0.0.1:3887 {
			lb_policy weighted_round_robin 1 9
			lb_try_duration 5s
			fail_duration 30s
			max_fails 3
			unhealthy_status 5xx
			health_uri /api/status
			health_interval 15s
			health_timeout 3s
			flush_interval -1

			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up Connection {>Connection}
			header_up Upgrade {>Upgrade}

			transport http {
				read_timeout  30m
				write_timeout 30m
				dial_timeout  10s
			}
		}
	}

	handle /v1beta/* {
		reverse_proxy http://127.0.0.1:3888 http://127.0.0.1:3887 {
			lb_policy weighted_round_robin 1 9
			health_uri /api/status
			health_interval 15s
			flush_interval -1
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout  30m
				write_timeout 30m
			}
		}
	}

	handle /mj/* {
		reverse_proxy http://127.0.0.1:3888 http://127.0.0.1:3887 {
			lb_policy weighted_round_robin 1 9
			flush_interval -1
		}
	}

	handle /suno/* {
		reverse_proxy http://127.0.0.1:3888 http://127.0.0.1:3887 {
			lb_policy weighted_round_robin 1 9
			flush_interval -1
		}
	}

	# 前端 SPA / 静态资源等钉主
	handle {
		reverse_proxy http://127.0.0.1:3888
	}

	log {
		output file /var/log/caddy/access.log
		format json
	}
}

epay.wormholexyz.xyz {
	# tls carmine.joint@gmail.com


# 复制为 .env 后使用；取值与仓库根目录 docker-compose.yml 对齐
#   cp .env.example .env && chmod 600 .env
# 主从节点须使用相同的 SESSION_SECRET / CRYPTO_SECRET / SQL_DSN（及共享 Redis）

# 镜像（与根目录 compose 的 image 一致；本地需先 docker compose build）
IMAGE=wingrid-api:local

# 对外端口（与根目录 ports "3888:3000"、Caddy reverse_proxy 一致）
HOST_PORT=3888

# 多机部署必须设置且所有节点一致（根目录 compose 里当前为注释，上线前请改成随机串）
# 生成：openssl rand -hex 32
SESSION_SECRET=533b7dff49e4bb1a229c6c64b9ea77fd227860e8743acd7d26968dbde36488a8
CRYPTO_SECRET=c33677fde52cd8113131a86667aa9910680b8bb726916a782c13177e3ad6c9a6

# 共享数据库（start-master.sh local|prod 会覆盖此值）
#   local → postgresql://root:…@101.132.81.209:5432/new-api
#   prod  → postgresql://root:…@172.16.0.246:5432/new-api
SQL_DSN=postgresql://root:2026@Biscuits@101.132.81.209:5432/new-api

# MySQL 示例（若改用 MySQL，取消注释并注释掉上面一行）：
# SQL_DSN=root:123456@tcp(mysql:3306)/new-api

# 共享 Redis（主从必须共用主节点的 new-api-redis）
# 主节点：连本 compose 内 redis 服务名
REDIS_CONN_STRING=redis://:2026@Biscuits@redis:6379
REDIS_PASSWORD=2026@Biscuits
# 从节点必填：主节点可达 IP/主机名（start-slave.sh 会据此覆盖 REDIS_CONN_STRING）
MASTER_HOST=172.16.0.246
# 覆盖后等价于：redis://:REDIS_PASSWORD@MASTER_HOST:6379

# 与根目录 environment 对应的可选项（compose 里已写死时可忽略）
# TZ=Asia/Shanghai
# ERROR_LOG_ENABLED=true
# BATCH_UPDATE_ENABLED=true
# SYNC_FREQUENCY=60
# STREAMING_TIMEOUT=300
# RELAY_IDLE_CONN_TIMEOUT=90

# 从节点：在 docker-compose.slave.yml 的 command 里改 NODE_NAME（每台唯一）
# 根目录当前为 NODE_NAME=new-api-node-1
# NODE_NAME=new-api-slave-1

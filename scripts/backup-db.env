# 数据库备份配置
# 复制为 backup-db.env / db.env 或 /etc/new-api/backup-db.env 后填写真实值
#   chmod 600 scripts/backup-db.env
#
# 脚本按顺序备份 DB_*，若设置了 DB2_NAME 再备份第二个库。
# 每个库写入各自目录；PostgreSQL 会备份该库下全部用户 schema。

# 数据库类型: postgres | mysql
DB_TYPE=postgres

# 第一个库: new-api（宿主机 5432，容器 postgres）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=2026@Biscuits
DB_NAME=new-api
BACKUP_DIR=/home/data/new-api/backup

# 第二个库: lifeos（宿主机 6543，容器 longevityOS-pg）
DB2_HOST=127.0.0.1
DB2_PORT=6543
DB2_USER=root
DB2_PASSWORD=2026@LBiscuits
DB2_NAME=lifeos
DB2_BACKUP_DIR=/home/data/longevityOS-pg/backup

# RETENTION_DAYS=15

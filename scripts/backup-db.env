# new-api 数据库备份配置
# 复制为 backup-db.env 或 /etc/new-api/backup-db.env 后填写真实值
#   cp scripts/backup-db.env.example scripts/backup-db.env
#   chmod 600 scripts/backup-db.env

# 数据库类型: postgres | mysql
DB_TYPE=postgres

# 连接信息（与 docker-compose.yml 中 SQL_DSN 对应）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=2026@Biscuits
DB_NAME=new-api

# 可选覆盖默认值
# BACKUP_DIR=/home/data/backup
# RETENTION_DAYS=15
